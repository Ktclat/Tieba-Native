<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        android:stateListAnimator="@null">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_back"
                style="@style/Widget.Material3Expressive.Button.IconButton.Tonal"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start"
                android:contentDescription="@string/button_back"
                app:icon="@drawable/ic_round_arrow_back" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_finish"
                style="@style/Widget.Material3Expressive.Button.IconButton.Filled"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:contentDescription="@string/button_finish"
                android:visibility="gone"
                app:icon="@drawable/ic_round_check" />
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <View
        android:id="@+id/mask"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/bottom_sheet"
        style="@style/Widget.Material3.BottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:clipToPadding="false"
        app:backgroundTint="?attr/colorSurfaceContainerLow"
        app:behavior_peekHeight="144dp"
        app:layout_behavior="@string/bottom_sheet_behavior"
        app:paddingBottomSystemWindowInsets="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingBottom="24dp">

            <com.google.android.material.bottomsheet.BottomSheetDragHandleView
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_ui_settings"
                android:textAppearance="?attr/textAppearanceHeadlineSmall" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/select_pic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/title_select_pic"
                app:icon="@drawable/ic_round_image" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/color_theme"
                style="@style/Widget.Material3Expressive.MaterialButtonToggleGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/light_color"
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/light_color" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dark_color"
                    style="@style/Widget.Material3Expressive.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dark_color" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <LinearLayout
                android:id="@+id/select_color"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/ThemeEditor.Section"
                    android:text="@string/title_select_color" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/select_color_recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="ifContentScrolls" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/custom_color"
                    style="@style/Widget.Material3Expressive.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/title_custom_color"
                    app:icon="@drawable/ic_round_create" />
            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                style="@style/ThemeEditor.Section"
                android:labelFor="@id/alpha"
                android:text="@string/title_translucent_theme_alpha" />

            <com.google.android.material.slider.Slider
                android:id="@+id/alpha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="255" />

            <com.google.android.material.textview.MaterialTextView
                style="@style/ThemeEditor.Section"
                android:labelFor="@id/blur"
                android:text="@string/title_translucent_theme_blur" />

            <com.google.android.material.slider.Slider
                android:id="@+id/blur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="0"
                android:valueTo="100" />

            <LinearLayout
                android:id="@+id/recommend_wallpapers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textview.MaterialTextView
                    style="@style/ThemeEditor.Section"
                    android:text="@string/title_translucent_theme_wallpapers" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/wallpapers_rv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/experimental_tip"
                style="@style/Widget.Material3Expressive.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/title_translucent_theme_experimental_feature"
                app:icon="@drawable/ic_round_help_green" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <FrameLayout
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.google.android.material.loadingindicator.LoadingIndicator
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/text_loading" />
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
